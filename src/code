#Chatbot actions 
def create_chatbot(bot_name):
    # Update the responses to include the bot's name
    updated_pairs = []
    for pattern, responses in pairs:
        updated_responses = [response.format(bot_name=bot_name) for response in responses]
        updated_pairs.append([pattern, updated_responses])
    return Chat(updated_pairs, reflections)


def start_chat():
    print("Hello! Let's give me a name before we start.")
    bot_name = input("What would you like to call me? ").strip()
    if not bot_name:
        bot_name = "SummerBot"  
    print(f"Great! You can call me {bot_name}. Type 'quit' to exit.")

    chatbot = create_chatbot(bot_name)
    print("What health concerns do you have?")
    while True:
        user_input = input("You: ")
        if user_input.lower() == "quit":
            print(f"{bot_name}: Bye, take care. See you soon!")
            break
        response = chatbot.respond(user_input)
        print(f"{bot_name}:", response)

# Runing 
if __name__ == "__main__":
    start_chat()
